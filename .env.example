# ──────────────────────────────────────────────────────────────────
# GEMINI AI
# ──────────────────────────────────────────────────────────────────
# Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ──────────────────────────────────────────────────────────────────
# FIREBASE – Web SDK Configuration
# Encontre todos esses valores em:
#   Firebase Console → Configurações do projeto → Seus apps → SDK
# ──────────────────────────────────────────────────────────────────

# Identificador da sua aplicação Firebase (ex: "paro-gastos-xxxxx")
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"

# Domínio de autenticação OAuth (ex: "paro-gastos-xxxxx.firebaseapp.com")
VITE_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_AUTH_DOMAIN"

# URL do banco Realtime Database (se usado; deixe vazio se usar apenas Firestore)
VITE_FIREBASE_DATABASE_URL="YOUR_FIREBASE_DATABASE_URL"

# ID do projeto Firebase (ex: "paro-gastos-xxxxx")
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"

# Bucket do Firebase Storage (ex: "paro-gastos-xxxxx.appspot.com")
VITE_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_STORAGE_BUCKET"

# Sender ID para Firebase Cloud Messaging (ex: "123456789012")
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"

# ID da aplicação web registrada no Firebase (ex: "1:123456789012:web:abc123")
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"

# (Opcional) ID de rastreamento do Google Analytics, se habilitado no projeto
VITE_FIREBASE_MEASUREMENT_ID="YOUR_FIREBASE_MEASUREMENT_ID"

